{
  "name": "beats-studio",
  "private": true,
  "version": "1.0.0",
  "description": "A bilingual acoustic drum sequencer with per-bar time signatures and a PHP backend.",
  "repository": {
    "type": "git",
    "url": "https://github.com/konecnyjaromir/beats.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/api.mjs",
    "test:mysql": "node tests/mysql-api.mjs",
    "package:update": "node scripts/package-update.mjs",
    "package:server": "node scripts/package-update.mjs --server"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg2pdf.js": "^2.9.0",
    "vexflow": "^4.2.5"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.26.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.0"
  }
}
